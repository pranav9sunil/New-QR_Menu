rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurants/{restaurantId}/{allPaths=**} {
      // Allow read access to anyone
      allow read: if true;
      // Allow write access only to authenticated users (admins) from that restaurant
      // Note: In a production app, we'd verify the user's restaurantId match,
      // but to get it working now, we'll allow any authenticated user.
      allow write: if request.auth != null;
    }
  }
}
