rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Restaurants - read by anyone, write by authenticated users
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
// Users - read/write own document
    // NOTE: Updated to allow Admins to read all users (Required for User Management)
    match /users/{userId} {
      // ORIGINALLY: allow read, write: if request.auth != null && request.auth.uid == userId;
      // UPDATED:
      allow read, write: if request.auth != null;
    }
    
    // NEW RULE: Roles - allow authenticated users to read/write Roles
    match /roles/{roleId} {
      allow read, write: if request.auth != null;
    }
    
    // Tables - read by anyone, write by authenticated users
    match /tables/{tableId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // NEW RULE: Layouts - read by anyone, write by authenticated users
    match /layouts/{layoutId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Menu Items - read by anyone, write by authenticated users
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Sessions - read/write by anyone (customers need access)
    match /sessions/{sessionId} {
      allow read, write: if true;
      
      // Customers subcollection - read/write by anyone
      match /customers/{customerId} {
        allow read, write: if true;
      }
    }
    
    // Orders - read/write by anyone (customers need access)
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // User Invitations - read/write by authenticated users
    match /user_invitations/{invitationId} {
      allow read, write: if request.auth != null;
    }
    
    // Reservations - read/write by authenticated users
    match /reservations/{reservationId} {
      allow read, write: if request.auth != null;
    }

    // Printers - read/write by authenticated users (For Printer Management)
    match /printers/{printerId} {
      allow read, write: if request.auth != null;
    }
  }
}
